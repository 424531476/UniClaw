# UniClaws环境配置文件示例
# 复制此文件为 .env 并填写实际配置值

# ============================================
# API 配置
# ============================================

# OpenAI API 密钥（必填）
OPENAI_API_KEY=your_api_key_here

# OpenAI API 基础 URL（可选，使用默认 API 时可留空）
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# 模型配置
# ============================================

# 主模型名称，用于处理复杂任务（必填）
MODEL_NAME=openai/gpt-5.4

# 迷你模型名称，用于处理简单快速的小任务（可选，未设置时自动使用 MODEL_NAME）
MINI_MODEL_NAME=

# 模型温度参数，控制输出的随机性（0.0-2.0，默认 0.7）
TEMPERATURE=0.7

# 模型最大输出长度
MAX_TOKENS=

# 模型概率采样参数（0.0-1.0，默认 1.0）
TOP_P=

# ============================================
# 权限与网络配置
# ============================================

# 权限模式：auto（自动）/ manual（手动）/ accept-all（全部接受）/ plan（计划模式）
PERMISSION_MODE=auto

# 代理 URL（可选，需要代理访问时填写）
# PROXY_URL=http://127.0.0.1:7890

